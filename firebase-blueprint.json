{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Administrator account record for the school portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "password": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "admin"] },
        "assignedOffice": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "number" }
      },
      "required": ["username", "fullName", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled technical college student record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "admissionNo": { "type": "string", "maxLength": 64 },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "classId": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 100 },
        "term": { "type": "string", "maxLength": 64 },
        "session": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["admissionNo", "firstName", "lastName", "classId"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Academic and technical workshop staff member.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "staffId": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 }
      },
      "required": ["staffId", "fullName"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Technical and vocational class arm.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "arm": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 64 }
      },
      "required": ["name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "NBTE/NABTEB technical or core subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 }
      },
      "required": ["code", "name"]
    },
    "SchoolNews": {
      "title": "SchoolNews",
      "description": "Official school news and announcements.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "summary": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 20000 },
        "category": { "type": "string", "maxLength": 100 },
        "authorName": { "type": "string", "maxLength": 200 },
        "publishedAt": { "type": "number" }
      },
      "required": ["title", "content"]
    },
    "WebsiteCustomization": {
      "title": "WebsiteCustomization",
      "description": "Portal customization and school contact details.",
      "type": "object",
      "properties": {
        "heroTagline": { "type": "string", "maxLength": 500 },
        "heroAnnouncement": { "type": "string", "maxLength": 2000 },
        "principalWelcomeMessage": { "type": "string", "maxLength": 4000 },
        "schoolContactEmail": { "type": "string", "maxLength": 200 },
        "schoolPhone": { "type": "string", "maxLength": 100 },
        "schoolAddress": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminAccount",
      "description": "School administrator accounts"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Enrolled technical college students"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Teaching and technical workshop staff"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "School classes and trade arms"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Academic and vocational subjects"
    },
    "/school_news/{newsId}": {
      "schema": "SchoolNews",
      "description": "Public school news and dispatches"
    },
    "/website_customization/{docId}": {
      "schema": "WebsiteCustomization",
      "description": "Website customization and slider configuration"
    }
  }
}
